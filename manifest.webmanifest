  "icons": [
    {
      "src": "app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "static_preview/LC_App_V2_Preview_Contact_Sheet.png",
      "sizes": "2200x3200",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
